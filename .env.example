# Salin file ini menjadi .env lalu ganti semua password. File .env TIDAK di-commit ke Git.
# (PowerShell:  Copy-Item .env.example .env)

# PostgreSQL superuser / DBA (role hr_admin)
POSTGRES_PASSWORD=ganti_password_admin
PG_PORT=5432

# Role HudsonRide (dibuat otomatis oleh sql/04_rbac.sql)
HR_ETL_PASSWORD=ganti_password_etl
HR_ANALYST_PASSWORD=ganti_password_analyst
HR_DASHBOARD_PASSWORD=ganti_password_dashboard

# Airflow
AIRFLOW_DB_PASSWORD=ganti_password_airflow_db
AIRFLOW_SECRET_KEY=ganti_dengan_teks_acak_panjang
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=ganti_password_airflow

# pgAdmin
PGADMIN_EMAIL=admin@hudsonride.com
PGADMIN_PASSWORD=ganti_password_pgadmin

# Notifikasi email bila ETL gagal (opsional). Gmail: aktifkan Verifikasi 2 Langkah, lalu buat
# App Password di https://myaccount.google.com/apppasswords dan tulis TANPA spasi.
HR_ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
